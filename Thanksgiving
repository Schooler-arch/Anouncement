<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>School Announcement</title>
  <style>
    body {
      background-color: #2b1b17;
      color: #e67e22;
      font-family: 'Arial Black', Gadget, sans-serif;
      text-align: center;
      padding: 30px;
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      box-sizing: border-box;
    }

    .container {
      border: 5px solid #d35400;
      padding: 40px;
      border-radius: 15px;
      background-color: #1a0f0d;
      display: inline-block;
      min-width: 600px;
      max-width: 700px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      position: relative;
    }

    h1 {
      font-size: 3.5rem;
      text-shadow: 3px 3px #000, 0 0 20px #e67e22;
      margin: 0 0 20px 0;
    }

    p {
      color: #ffffff;
      font-size: 1.5rem;
      font-family: 'Arial', sans-serif;
    }

    .signature {
      font-size: 1.1rem;
      color: #f39c12;
      font-style: italic;
      font-family: 'Comic Sans MS', 'Arial', sans-serif;
      margin-top: 15px;
    }

    .emoji {
      font-size: 5rem;
      user-select: none;
    }

    /* Secret Easter Egg Trigger */
    .easter-egg-trigger {
      cursor: pointer;
      display: inline-block;
      transition: transform 0.15s ease;
    }
    .easter-egg-trigger:active {
      transform: scale(1.2);
    }

    .instruction {
      color: #888888;
      font-size: 1rem;
      font-family: sans-serif;
      margin-top: 25px;
    }

    /* Hidden Game Section */
    #game-section {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 2px dashed #d35400;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: all 0.5s ease;
    }

    .hidden {
      display: none !important;
    }

    .game-header {
      display: flex;
      justify-content: space-between;
      width: 100%;
      align-items: center;
      margin-bottom: 10px;
    }

    .game-title {
      font-size: 1.5rem;
      color: #f1c40f;
    }

    .close-btn {
      background: #c0392b;
      color: white;
      border: none;
      padding: 5px 12px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
    }

    .game-canvas-container {
      position: relative;
      width: 500px;
      height: 350px;
      border: 3px solid #f39c12;
      border-radius: 10px;
      overflow: hidden;
      background: #110806;
    }

    canvas {
      display: block;
      background: linear-gradient(to bottom, #2c1d11, #150a08);
    }

    /* Lock Overlay Screen */
    .lock-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(20, 10, 8, 0.95);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      color: #ffffff;
      padding: 20px;
      box-sizing: border-box;
      z-index: 10;
    }

    .lock-screen h2 {
      color: #e74c3c;
      margin-bottom: 10px;
      font-size: 1.8rem;
    }

    .lock-screen p {
      font-size: 1.1rem;
      color: #f39c12;
    }

    .hud {
      display: flex;
      justify-content: space-between;
      width: 500px;
      font-family: 'Arial', sans-serif;
      font-size: 1.2rem;
      color: #ffffff;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="emoji">
      <span id="turkey-trigger" class="easter-egg-trigger" title="???">🦃</span> 🍂 🍁
    </div>
    <h1>HAPPY THANKSGIVING WEEK!</h1>
    <p>Wishing you a wonderful week of learning and gratitude!</p>
    <p>Enjoy your upcoming break with family and friends! 🥧</p>
    <p class="signature">- Sent from You-Know-Who 🍂✨</p>

    <!-- Hidden Game Area -->
    <div id="game-section" class="hidden">
      <div class="game-header">
        <span class="game-title">🎉 Secret Turkey Catcher!</span>
        <button id="close-game" class="close-btn">✕ Hide</button>
      </div>

      <div class="hud">
        <span>Score: <strong id="score">0</strong></span>
        <span>Time: <strong id="timer">30</strong>s</span>
      </div>

      <div class="game-canvas-container">
        <!-- Locked Message Screen -->
        <div id="lock-screen" class="lock-screen hidden">
          <h2>🔒 Game Locked</h2>
          <p>You've already played your turn for Thanksgiving Week!</p>
          <p id="final-recorded-score" style="margin-top: 15px; color: #fff;"></p>
        </div>

        <canvas id="gameCanvas" width="500" height="350"></canvas>
      </div>
    </div>

    <div class="instruction">(Please close this tab to return to work)</div>
  </div>

  <script>
    // Game & State Management
    let clickCount = 0;
    const turkeyTrigger = document.getElementById('turkey-trigger');
    const gameSection = document.getElementById('game-section');
    const closeBtn = document.getElementById('close-game');
    const lockScreen = document.getElementById('lock-screen');
    const finalRecordedScore = document.getElementById('final-recorded-score');

    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const timerEl = document.getElementById('timer');

    let score = 0;
    let timeLeft = 30;
    let gameLoopId = null;
    let timerInterval = null;
    let isPlaying = false;

    // Game Objects
    const basket = { x: 210, y: 300, width: 80, height: 30, speed: 7 };
    let items = [];
    const keys = {};

    // Check localStorage status
    function hasPlayedBefore() {
      return localStorage.getItem('thanksgivingGamePlayed') === 'true';
    }

    // Secret 3-Click Trigger
    turkeyTrigger.addEventListener('click', () => {
      clickCount++;

      if (hasPlayedBefore()) {
        alert("🔒 You've already played your turn for Thanksgiving Week!");
        return;
      }

      if (clickCount >= 3) {
        gameSection.classList.remove('hidden');
        clickCount = 0;
        startMiniGame();
      }
    });

    // Hide game section
    closeBtn.addEventListener('click', () => {
      gameSection.classList.add('hidden');
    });

    // Key Listeners
    window.addEventListener('keydown', (e) => keys[e.key] = true);
    window.addEventListener('keyup', (e) => keys[e.key] = false);

    // Canvas Touch / Mouse movement
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      basket.x = e.clientX - rect.left - basket.width / 2;
    });

    function startMiniGame() {
      if (hasPlayedBefore()) {
        showLockScreen();
        return;
      }

      isPlaying = true;
      score = 0;
      timeLeft = 30;
      items = [];
      scoreEl.textContent = score;
      timerEl.textContent = timeLeft;

      // Timer Interval
      timerInterval = setInterval(() => {
        timeLeft--;
        timerEl.textContent = timeLeft;
        if (timeLeft <= 0) {
          endGame();
        }
      }, 1000);

      // Start loop
      gameLoop();
    }

    function spawnItem() {
      if (Math.random() < 0.04) {
        const types = [
          { symbol: '🦃', points: 10 },
          { symbol: '🍂', points: 5 },
          { symbol: '🥧', points: 15 },
          { symbol: '💣', points: -10 }
        ];
        const selected = types[Math.floor(Math.random() * types.length)];
        items.push({
          x: Math.random() * (canvas.width - 30),
          y: -30,
          speed: 2 + Math.random() * 3,
          ...selected
        });
      }
    }

    function gameLoop() {
      if (!isPlaying) return;

      // Clear
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Move Basket
      if (keys['ArrowLeft'] || keys['a']) basket.x -= basket.speed;
      if (keys['ArrowRight'] || keys['d']) basket.x += basket.speed;

      // Keep basket in bounds
      if (basket.x < 0) basket.x = 0;
      if (basket.x + basket.width > canvas.width) basket.x = canvas.width - basket.width;

      // Draw Basket
      ctx.font = '30px Sans-Serif';
      ctx.fillText('🧺', basket.x + 20, basket.y + 25);

      // Spawn & Process Items
      spawnItem();

      for (let i = items.length - 1; i >= 0; i--) {
        const item = items[i];
        item.y += item.speed;

        // Draw Item
        ctx.font = '24px Sans-Serif';
        ctx.fillText(item.symbol, item.x, item.y);

        // Collision Check
        if (
          item.y >= basket.y - 10 &&
          item.y <= basket.y + basket.height &&
          item.x >= basket.x - 10 &&
          item.x <= basket.x + basket.width
        ) {
          score += item.points;
          if (score < 0) score = 0;
          scoreEl.textContent = score;
          items.splice(i, 1);
          continue;
        }

        // Out of bounds
        if (item.y > canvas.height + 30) {
          items.splice(i, 1);
        }
      }

      gameLoopId = requestAnimationFrame(gameLoop);
    }

    function endGame() {
      isPlaying = false;
      clearInterval(timerInterval);
      cancelAnimationFrame(gameLoopId);

      // Save lock state in localStorage
      localStorage.setItem('thanksgivingGamePlayed', 'true');
      localStorage.setItem('thanksgivingGameScore', score);

      showLockScreen();
    }

    function showLockScreen() {
      const savedScore = localStorage.getItem('thanksgivingGameScore') || score;
      finalRecordedScore.textContent = `Final Score: ${savedScore} pts`;
      lockScreen.classList.remove('hidden');
    }
  </script>
</body>
</html>
